---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import pricingData from '../../content/pricing.json';
import { tableIcon } from '../../lib/tableIcon';
import Icon from '../../components/Icon.astro';
import { Check, TriangleAlert, Trophy } from '@lucide/astro';

// Precios leídos de pricing.json en build-time
const svcPlan = pricingData.businessTypes.find(bt => bt.id === 'servicios');
const svcPrice = svcPlan?.monthly ?? 19;
const reservioProPrice = 63; // competidor — verificado reservio.com/es abril 2026
const savingAnnual = (reservioProPrice - svcPrice) * 12;

const pageTitle = 'Reservio vs Agenda de Reservas (2026) | Soporte local en español';
const pageDescription = 'Reservio (alemán) vs Agenda de Reservas (española). WhatsApp disponible, soporte en español nativo y 19€/mes para todo tu equipo. Precios reales 2026.';
const canonicalUrl = 'https://agendadereservas.com/vs/reservio/';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Reservio vs Agenda de Reservas (2026) | Soporte local en español',
  description: 'Análisis completo entre Agenda de Reservas y Reservio',
  author: { '@type': 'Organization', name: 'Agenda de Reservas' },
  publisher: { '@type': 'Organization', name: 'Agenda de Reservas' },
  datePublished: '2026-01-01',
  dateModified: '2026-06-15'
};

const comparisonRows = [
  { feature: 'Precio plan básico', agendadereservas: `<span data-price-key="service_business.monthly">${svcPrice}</span>€/mes (IA, comunicaciones e informes incluidos)`, reservio: '0€ (limitado) / 31€ (pro)', winner: 'agendadereservas' },
  { feature: 'Precio plan premium', agendadereservas: `<span data-price-key="service_business.monthly">${svcPrice}</span>€ (\u00fanico plan)`, reservio: `${reservioProPrice}€/mes (max 5 staff)`, winner: 'agendadereservas' },
  { feature: 'Usuarios/staff', agendadereservas: 'Ilimitados', reservio: 'Limitado por plan', winner: 'agendadereservas' },
  { feature: 'Reservas mensuales', agendadereservas: 'Ilimitadas', reservio: 'Limitadas en plan gratis', winner: 'agendadereservas' },
  { feature: 'Soporte en español', agendadereservas: `${tableIcon('check','text-green-600')} Nativo (chat/email)`, reservio: `${tableIcon('warn','text-amber-500')} Inglés/Alemán principal`, winner: 'agendadereservas' },
  { feature: 'WhatsApp Business', agendadereservas: `${tableIcon('check','text-green-600')} Disponible (+<span data-price-key="addon_whatsapp.monthly">28</span>€/mes)`, reservio: `${tableIcon('x','text-red-500')} No disponible`, winner: 'agendadereservas' },
  { feature: 'Recordatorios SMS', agendadereservas: `${tableIcon('check','text-green-600')} Disponible (+<span data-price-key="addon_sms.monthly">15</span>€/mes)`, reservio: `${tableIcon('warn','text-amber-500')} Pago aparte`, winner: 'agendadereservas' },
  { feature: 'Presets por sector', agendadereservas: `${tableIcon('check','text-green-600')} Peluquería, estética, turismo`, reservio: `${tableIcon('warn','text-amber-500')} Genérico`, winner: 'agendadereservas' },
  { feature: 'Pagos online', agendadereservas: `${tableIcon('check','text-green-600')} Stripe (+<span data-price-key="addon_payments.monthly">18</span>€/mes)`, reservio: `${tableIcon('check','text-green-600')} Stripe/PayPal`, winner: 'tie' },
  { feature: 'Calendario Google', agendadereservas: `${tableIcon('check','text-green-600')} Sync bidireccional`, reservio: `${tableIcon('check','text-green-600')} Sync bidireccional`, winner: 'tie' },
  { feature: 'Interfaz en español', agendadereservas: `${tableIcon('check','text-green-600')} 100% traducida`, reservio: `${tableIcon('warn','text-amber-500')} Algunas partes en inglés`, winner: 'agendadereservas' },
  { feature: 'App móvil nativa', agendadereservas: `${tableIcon('x','text-red-500')} Web app responsive`, reservio: `${tableIcon('check','text-green-600')} App nativa`, winner: 'reservio' },
  { feature: 'Integraciones', agendadereservas: `${tableIcon('warn','text-amber-500')} Básicas (Zapier)`, reservio: `${tableIcon('check','text-green-600')} Muchas integraciones`, winner: 'reservio' },
  { feature: 'Personalización marca', agendadereservas: `${tableIcon('check','text-green-600')} Completa`, reservio: `${tableIcon('check','text-green-600')} Completa`, winner: 'tie' },
];
---

<Layout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl} schema={schema}>
  <Header />
  
  <main class="pt-24">
    <section class="py-16 bg-gradient-to-br from-blue-50 to-white">
      <div class="container mx-auto px-4 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">Agenda de Reservas vs Reservio</h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Comparativa detallada entre el software español y el alemán. Soporte, precios y funcionalidades.
        </p>
      </div>
    </section>

    <section class="py-12">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="overflow-x-auto">
          <table class="w-full bg-white rounded-xl shadow-sm">
            <thead>
              <tr class="bg-gray-100">
                <th class="p-4 text-left">Característica</th>
                <th class="p-4 text-center text-blue-600 w-1/3">Agenda de Reservas</th>
                <th class="p-4 text-center text-purple-600 w-1/3">Reservio</th>
              </tr>
            </thead>
            <tbody>
              {comparisonRows.map((row, i) => (
                <tr class={`border-t ${i % 2 === 1 ? 'bg-gray-50' : ''}`}>
                  <td class="p-4 font-medium">{row.feature}</td>
                  <td class={`p-4 text-center ${row.winner === 'agendadereservas' ? 'font-semibold text-green-600' : ''}`}>
                    <span set:html={row.agendadereservas} /> {row.winner === 'agendadereservas' && <Icon icon={Trophy} size={16} />}
                  </td>
                  <td class={`p-4 text-center ${row.winner === 'reservio' ? 'font-semibold text-green-600' : ''}`}>
                    <span set:html={row.reservio} /> {row.winner === 'reservio' && <Icon icon={Trophy} size={16} />}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-4 max-w-4xl">
        <h2 class="text-2xl font-bold text-center mb-8">La diferencia principal: Soporte local</h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-6 rounded-xl">
            <h3 class="font-bold text-lg mb-4 text-blue-600">🇪🇸 Agenda de Reservas</h3>
            <ul class="space-y-2 text-sm">
              <li><Icon icon={Check} size={16} /> Equipo en España</li>
              <li><Icon icon={Check} size={16} /> Soporte en español nativo</li>
              <li><Icon icon={Check} size={16} /> Horario español (9-18h)</li>
              <li><Icon icon={Check} size={16} /> Entiende tu negocio local</li>
              <li><Icon icon={Check} size={16} /> Presets para sectores españoles</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-xl">
            <h3 class="font-bold text-lg mb-4 text-purple-600">🇩🇪 Reservio</h3>
            <ul class="space-y-2 text-sm">
              <li><Icon icon={TriangleAlert} size={16} /> Empresa alemana</li>
              <li><Icon icon={TriangleAlert} size={16} /> Soporte principal en inglés/alemán</li>
              <li><Icon icon={TriangleAlert} size={16} /> Horario europeo central</li>
              <li><Icon icon={TriangleAlert} size={16} /> Mercado enfocado en Europa Central</li>
              <li><Icon icon={TriangleAlert} size={16} /> Menos adaptado a España</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-2xl font-bold mb-4">Precios comparados (3 empleados)</h2>
        <div class="flex justify-center gap-8 mb-8">
          <div class="text-center">
            <p class="text-sm text-gray-600">Agenda de Reservas</p>
            <p class="text-3xl font-bold text-blue-600"><span data-price-key="service_business.monthly">{svcPrice}</span>€/mes</p>
          </div>
          <div class="text-center">
            <p class="text-sm text-gray-600">Reservio Pro</p>
            <p class="text-3xl font-bold text-purple-600">63€/mes</p>
          </div>
        </div>
        <p class="text-green-600 font-semibold text-xl">Ahorro anual con Agenda de Reservas: {savingAnnual.toLocaleString('es-ES')}€</p>
      </div>
    </section>

    <section class="py-16 bg-blue-600 text-white text-center">
      <div class="container mx-auto px-4">
        <h2 class="text-2xl font-bold mb-4">¿Prefieres soporte local?</h2>
        <p class="mb-6">Prueba Agenda de Reservas gratis 14 días. Sin tarjeta.</p>
        <a href="https://app.agendadereservas.com" class="inline-block px-8 py-4 bg-white text-blue-600 rounded-lg font-semibold hover:bg-gray-100">
          Empezar prueba gratuita →
        </a>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>

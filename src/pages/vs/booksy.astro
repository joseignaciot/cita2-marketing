
---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/apple-design.css';
import pricingData from '../../content/pricing.json';
import { tableIcon } from '../../lib/tableIcon';
import Icon from '../../components/Icon.astro';
import { Check } from '@lucide/astro';

// Precio de build-time: leer de pricing.json para coherencia con el resto del sitio
const svcPlan = pricingData.businessTypes.find(bt => bt.id === 'servicios');
const svcPrice = svcPlan?.monthly ?? 19; // fallback si la estructura cambia
const whatsappAddon = pricingData.addons.find(a => a.id === 'whatsapp');
const whatsappPrice = whatsappAddon?.price ?? 28;

// Tarifa publicada por Booksy (biz.booksy.com/es-es/precios, consultada el 2026-11-03):
// 34,99 € + IVA al mes con 1 usuario, +8 € + IVA al mes por cada usuario adicional.
const booksyBase = 34.99;
const booksyExtra = 8;
const fmt = (n: number) => n.toFixed(2).replace('.', ',');
const booksyCost = (employees: number) => booksyBase + booksyExtra * (employees - 1);
const annualSaving3 = Math.round((booksyCost(3) - svcPrice) * 12);

const pageTitle = 'Alternativa a Booksy: precios reales y comparativa (2026)';
const pageDescription = 'Booksy cuesta 34,99 € + IVA al mes y 8 € por cada empleado extra. Agenda de Reservas: desde 19 €/mes fijo para todo el equipo, sin comisiones.';
const canonicalUrl = 'https://agendadereservas.com/vs/booksy/';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: '¿Booksy cobra por empleado?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: `Sí, a partir del primer usuario. Booksy cuesta ${fmt(booksyBase)}€ + IVA al mes con un usuario y suma ${booksyExtra}€ + IVA al mes por cada empleado adicional. Una peluquería con 3 empleados paga unos ${fmt(booksyCost(3))}€/mes más IVA. Agenda de Reservas cobra un precio fijo único sin límite de empleados.`
          }
        },
        {
          '@type': 'Question',
          name: '¿Booksy tiene WhatsApp Business integrado?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No. Booksy no integra WhatsApp Business API. Solo envía recordatorios por email y notificaciones push de su app. Agenda de Reservas integra WhatsApp Business API oficial con mensajes que llegan con un 90% de tasa de apertura.'
          }
        },
        {
          '@type': 'Question',
          name: '¿Cuál es más barato para una peluquería con 3 empleados?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: `Agenda de Reservas: ${svcPrice}€/mes fijo. Booksy: ${fmt(booksyCost(3))}€/mes + IVA (${fmt(booksyBase)}€ + 2 × ${booksyExtra}€). El ahorro anual con 3 empleados es de unos ${annualSaving3}€, sin contar las comisiones de Boost ni las tarifas de pago de Booksy.`
          }
        },
        {
          '@type': 'Question',
          name: '¿Booksy funciona en España en español?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Booksy está disponible en España pero el soporte en español es limitado. Agenda de Reservas está creada en España, con soporte humano en español, RGPD europeo y precios en euros.'
          }
        }
      ]
    },
    {
      '@type': 'Article',
      headline: pageTitle,
      description: pageDescription,
      datePublished: '2026-04-01',
      dateModified: '2026-11-03',
      author: {
        '@type': 'Organization',
        name: 'Agenda de Reservas'
      }
    }
  ]
};

const pagosAddon = pricingData.addons.find(a => a.id === 'pagos');
const pagosPrice = pagosAddon?.price ?? 18;

const comparativa = [
  { feature: 'Precio base', booksy: `${fmt(booksyBase)}€ + IVA/mes (1 usuario), +${booksyExtra}€ por usuario extra`, agenda: `<span data-price-key="service_business.monthly">${svcPrice}</span>€/mes fijo total`, winner: 'agenda' },
  { feature: '3 empleados', booksy: `${fmt(booksyCost(3))}€/mes + IVA`, agenda: `<span data-price-key="service_business.monthly">${svcPrice}</span>€/mes`, winner: 'agenda' },
  { feature: '5 empleados', booksy: `${fmt(booksyCost(5))}€/mes + IVA`, agenda: `<span data-price-key="service_business.monthly">${svcPrice}</span>€/mes`, winner: 'agenda' },
  { feature: 'Clientes nuevos (Boost)', booksy: 'Opcional: 30% de la 1.ª visita (máx. 50€ + IVA)', agenda: 'Sin comisiones por reserva', winner: 'agenda' },
  { feature: 'WhatsApp Business API', booksy: `${tableIcon('x','text-red-500')} No`, agenda: `${tableIcon('check','text-green-600')} Disponible (+<span data-price-key="addon_whatsapp.monthly">${whatsappPrice}</span>€/mes)`, winner: 'agenda' },
  { feature: 'Soporte en español', booksy: `${tableIcon('warn','text-amber-500')} Limitado`, agenda: `${tableIcon('check','text-green-600')} Humano, <2h`, winner: 'agenda' },
  { feature: 'RGPD / datos en Europa', booksy: `${tableIcon('warn','text-amber-500')} USA (Booksy Inc.)`, agenda: `${tableIcon('check','text-green-600')} Servidores EU`, winner: 'agenda' },
  { feature: 'Pagos online con Stripe', booksy: `${tableIcon('check','text-green-600')} Sí`, agenda: `${tableIcon('check','text-green-600')} Sí (+<span data-price-key="addon_payments.monthly">${pagosPrice}</span>€/mes)`, winner: 'empate' },
  { feature: 'App para clientes', booksy: `${tableIcon('check','text-green-600')} App propia (Booksy)`, agenda: `${tableIcon('check','text-green-600')} Página web responsive`, winner: 'empate' },
  { feature: 'Marketplace de clientes', booksy: `${tableIcon('check','text-green-600')} Sí (Booksy App)`, agenda: `${tableIcon('x','text-red-500')} No`, winner: 'booksy' },
  { feature: 'Multi-sector', booksy: `${tableIcon('warn','text-amber-500')} Solo belleza`, agenda: `${tableIcon('check','text-green-600')} Servicios, restaurantes, turismo`, winner: 'agenda' },
  { feature: 'API / Integraciones', booksy: `${tableIcon('warn','text-amber-500')} Limitado`, agenda: `${tableIcon('check','text-green-600')} Webhook + Zapier`, winner: 'agenda' },
  { feature: 'Precio en euros', booksy: `${tableIcon('warn','text-amber-500')} Variable (USD base)`, agenda: `${tableIcon('check','text-green-600')} Euros fijos`, winner: 'agenda' },
];

// Cálculos pre-computados (evitar expresiones aritméticas en template literals del frontmatter)
const savings = [1, 2, 3, 5].map((employees) => ({
  size: employees === 1 ? '1 empleado' : `${employees} empleados`,
  booksyRange: `${fmt(booksyCost(employees))}€/mes + IVA`,
  saving: `Ahorras ${fmt(booksyCost(employees) - svcPrice)}€/mes`,
}));
---

<Layout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl} schema={schema}>
  <Header />

  <main>
    <!-- Hero comparativa -->
    <section class="section-apple bg-white border-b border-gray-100">
      <div class="container-apple">
        <div class="text-center max-w-3xl mx-auto">
          <span class="feature-bubble mb-4 inline-block">Comparativa verificada · Noviembre 2026</span>
          <h1 class="text-headline text-gray-900 mb-6">
            Booksy vs Agenda de Reservas:<br/>
            <span class="text-blue-600">La comparativa que Booksy no quiere que veas</span>
          </h1>
          <p class="text-body text-lg mb-8">
            Booksy cuesta {fmt(booksyBase)}€ + IVA al mes y suma {booksyExtra}€ por cada empleado extra. Con 3 peluqueros en plantilla, pagas <strong class="text-red-600">unos {fmt(booksyCost(3))}€/mes + IVA</strong>. Agenda de Reservas: <strong class="text-green-600"><span data-price-key="service_business.monthly">{svcPrice}</span>€/mes para todo tu equipo</strong>, sin límites.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="https://app.agendadereservas.com" class="btn-apple-primary px-8 py-4">
              Empezar gratis — sin tarjeta
            </a>
            <a href="#comparativa" class="btn-apple-secondary px-8 py-4">
              Ver comparativa completa ↓
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- El número que más importa -->
    <section class="section-apple bg-red-50 border-b border-red-100">
      <div class="container-apple">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl font-bold text-gray-900 text-center mb-10">
            El coste real de Booksy por tamaño de negocio
          </h2>
          <div class="grid md:grid-cols-4 gap-4">
            {savings.map(({ size, booksyRange, saving }) => (
              <div class="bg-white rounded-2xl p-5 border border-red-100 text-center">
                <p class="font-bold text-gray-900 mb-3">{size}</p>
                <p class="text-sm text-gray-500 mb-1">Booksy:</p>
                <p class="text-red-600 font-bold mb-2">{booksyRange}</p>
                <p class="text-sm text-gray-500 mb-1">Agenda de Reservas:</p>
                <p class="text-green-600 font-bold mb-3"><span data-price-key="service_business.monthly">{svcPrice}</span>€/mes</p>
                <span class="text-xs bg-green-100 text-green-800 px-2 py-1 rounded-full font-semibold">{saving}</span>
              </div>
            ))}
          </div>
          <p class="text-center text-xs text-gray-600 mt-4">Tarifa publicada por Booksy en biz.booksy.com/es-es/precios (sin IVA), consultada el 3 de noviembre de 2026. No incluye las comisiones de Boost ni las tarifas de pago.</p>
        </div>
      </div>
    </section>

    <!-- Tabla comparativa completa -->
    <section id="comparativa" class="section-apple bg-white">
      <div class="container-apple">
        <h2 class="text-headline text-gray-900 text-center mb-12">Comparativa feature a feature</h2>

        <div class="max-w-4xl mx-auto overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b-2 border-gray-200">
                <th class="text-left py-4 px-4 text-gray-700 font-semibold">Característica</th>
                <th class="text-center py-4 px-4 text-gray-600 font-semibold">Booksy</th>
                <th class="text-center py-4 px-4 text-blue-700 font-semibold bg-blue-50 rounded-t-lg">Agenda de Reservas</th>
              </tr>
            </thead>
            <tbody>
              {comparativa.map(({ feature, booksy, agenda, winner }) => (
                <tr class="border-b border-gray-100 hover:bg-gray-50">
                  <td class="py-3 px-4 font-medium text-gray-800">{feature}</td>
                  <td class={`py-3 px-4 text-center ${winner === 'booksy' ? 'text-green-700 font-semibold' : winner === 'agenda' ? 'text-red-600' : 'text-gray-600'}`} set:html={booksy}>
                  </td>
                  <td class={`py-3 px-4 text-center bg-blue-50 ${winner === 'agenda' ? 'text-green-700 font-bold' : winner === 'booksy' ? 'text-red-600' : 'text-gray-600'}`} set:html={agenda}>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="text-xs text-gray-600 mt-4 text-right">Precios de Booksy (sin IVA) de biz.booksy.com/es-es/precios, 3 de noviembre de 2026.</p>
        </div>
      </div>
    </section>

    <!-- Cuándo elegir Booksy -->
    <section class="section-apple bg-gray-50">
      <div class="container-apple">
        <div class="max-w-4xl mx-auto grid md:grid-cols-2 gap-8">
          <div class="bg-white rounded-2xl p-8 border border-gray-200">
            <h3 class="font-bold text-gray-900 text-lg mb-4">Elige Booksy si...</h3>
            <ul class="space-y-3 text-sm text-gray-700">
              {[
                'Quieres aparecer en el marketplace de Booksy para captar clientes nuevos',
                'Trabajas solo y te compensa más su marketplace que la diferencia de precio',
                'La mayoría de tus clientes ya usan la app de Booksy',
                'No necesitas WhatsApp Business integrado'
              ].map(item => (
                <li class="flex items-start gap-2">
                  <span class="text-blue-500 mt-0.5 flex-shrink-0">→</span>
                  <span set:html={item} />
                </li>
              ))}
            </ul>
          </div>

          <div class="bg-blue-50 rounded-2xl p-8 border-2 border-blue-200">
            <h3 class="font-bold text-gray-900 text-lg mb-4">Elige Agenda de Reservas si...</h3>
            <ul class="space-y-3 text-sm text-gray-800">
              {[
                'Tienes 2 o más empleados y no quieres pagar por usuario',
                'Quieres WhatsApp Business API con 90% de apertura de mensajes',
                'Gestionas también restaurante o actividades turísticas',
                'Necesitas soporte humano en español con respuesta rápida',
                'Quieres tus datos en servidores europeos (RGPD)'
              ].map(item => (
                <li class="flex items-start gap-2">
                  <span class="text-green-600 mt-0.5 flex-shrink-0 font-bold"><Icon icon={Check} size={16} /></span>
                  <span set:html={item} />
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section-apple bg-white">
      <div class="container-apple max-w-3xl mx-auto">
        <h2 class="text-headline text-gray-900 text-center mb-12">Preguntas frecuentes</h2>
        <div class="space-y-4">
          {[
            {
              q: '¿Booksy cobra por empleado?',
              a: `Sí, a partir del primer usuario. Booksy cuesta ${fmt(booksyBase)}€ + IVA al mes con un usuario y suma ${booksyExtra}€ + IVA al mes por cada empleado adicional. Una peluquería con 3 empleados paga unos ${fmt(booksyCost(3))}€/mes más IVA, y con 5 empleados unos ${fmt(booksyCost(5))}€. Agenda de Reservas cobra <span data-price-key="service_business.monthly">19</span>€/mes para todo tu equipo sin importar cuántos sois.`
            },
            {
              q: '¿Booksy tiene WhatsApp Business integrado?',
              a: 'No. Booksy solo envía notificaciones push de su app y emails. No integra WhatsApp Business API. Agenda de Reservas tiene WhatsApp Business API oficial disponible como módulo por +<span data-price-key="addon_whatsapp.monthly">28</span>€/mes, con mensajes de 90% de tasa de apertura.'
            },
            {
              q: '¿Cuál es más barato para una peluquería con 3 empleados?',
              a: `Agenda de Reservas: <span data-price-key="service_business.monthly">19</span>€/mes fijo. Booksy: ${fmt(booksyCost(3))}€/mes + IVA (${fmt(booksyBase)}€ + 2 × ${booksyExtra}€). El ahorro anual con 3 empleados es de unos ${annualSaving3}€, sin contar las comisiones de Boost (30% de la primera visita de cada cliente nuevo de Booksy, máx. 50€) ni las tarifas de pago (2% + 0,15€ por pago móvil).`
            },
            {
              q: '¿Puedo migrar de Booksy a Agenda de Reservas sin perder datos?',
              a: 'Sí. Exporta tu lista de clientes desde Booksy en CSV e impórtala en Agenda de Reservas. Te ayudamos con la migración de forma gratuita. El proceso lleva menos de 1 hora.'
            },
            {
              q: '¿Agenda de Reservas tiene marketplace como Booksy?',
              a: 'No. A diferencia de Booksy, no tenemos un marketplace de captación de nuevos clientes. Agenda de Reservas es un software de gestión para tu negocio: tus clientes reservan directamente en tu página, sin intermediarios.'
            }
          ].map(({ q, a }) => (
            <div class="border border-gray-200 rounded-xl overflow-hidden">
              <details class="group">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer font-semibold text-gray-900 hover:bg-gray-50">
                  {q}
                  <span class="text-gray-400 group-open:rotate-180 transition-transform">▾</span>
                </summary>
                <div class="px-6 pb-4 text-gray-600 text-sm leading-relaxed" set:html={a}></div>
              </details>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA final -->
    <section class="section-apple bg-gray-900">
      <div class="container-apple text-center">
        <h2 class="text-headline text-white mb-4">
          ¿Cansado de pagar por cada empleado?<br/>
          <span class="text-blue-400"><span data-price-key="service_business.monthly">{svcPrice}</span>€/mes para todo tu equipo.</span>
        </h2>
        <p class="text-gray-400 mb-2">Sin comisiones · Sin permanencia · Soporte humano en español</p>
        <p class="text-gray-500 text-sm mb-8">Migración gratuita desde Booksy</p>
        <a href="https://app.agendadereservas.com" class="inline-block bg-white text-gray-900 font-bold px-10 py-4 rounded-2xl hover:bg-gray-100 transition-colors">
          Prueba gratis 14 días — sin tarjeta
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

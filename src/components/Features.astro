---
import Icon from './Icon.astro';
import { Calendar, Bell, Users, CreditCard, MessageSquare, ChartColumn, Smartphone, Zap } from '@lucide/astro';

interface Feature {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  title: string;
  subtitle?: string;
  features: Feature[];
  columns?: 2 | 3 | 4;
}

const { title, subtitle, features, columns = 3 } = Astro.props;

const gridCols = {
  2: 'md:grid-cols-2',
  3: 'md:grid-cols-2 lg:grid-cols-3',
  4: 'md:grid-cols-2 lg:grid-cols-4',
};

const icons: Record<string, any> = {
  calendar: Calendar,
  bell: Bell,
  users: Users,
  credit: CreditCard,
  message: MessageSquare,
  chart: ChartColumn,
  smartphone: Smartphone,
  zap: Zap,
};
---

<section class="section-padding bg-white" id="producto">
  <div class="max-w-7xl mx-auto container-padding">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900">
        {title}
      </h2>
      {subtitle && (
        <p class="mt-4 text-lg text-gray-600">
          {subtitle}
        </p>
      )}
    </div>
    
    <div class={`grid ${gridCols[columns]} gap-8`}>
      {features.map((feature) => (
        <div class="relative p-6 bg-gray-50 rounded-xl hover:bg-gray-100 transition-colors duration-200">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
            <Icon icon={icons[feature.icon] || icons.calendar} size={24} class="text-primary-600" />
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">
            {feature.title}
          </h3>
          <p class="text-gray-600">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

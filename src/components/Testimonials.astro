---
import { Star } from '@lucide/astro';

interface Testimonial {
  quote: string;
  author: string;
  role: string;
  company: string;
  rating: number;
  image?: string;
}

interface Props {
  title: string;
  subtitle?: string;
  testimonials: Testimonial[];
}

const { title, subtitle, testimonials } = Astro.props;
---

<section class="section-padding bg-primary-50">
  <div class="max-w-7xl mx-auto container-padding">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900">
        {title}
      </h2>
      {subtitle && (
        <p class="mt-4 text-lg text-gray-600">
          {subtitle}
        </p>
      )}
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {testimonials.map((testimonial) => (
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <!-- Stars -->
          <div class="flex gap-1 mb-4">
            {Array.from({ length: 5 }).map((_, i) => (
              <Star
                size={20}
                fill="currentColor"
                stroke-width={0}
                class={i < testimonial.rating ? 'text-warning' : 'text-gray-300'}
              />
            ))}
          </div>
          
          <blockquote class="text-gray-700 mb-6">
            "{testimonial.quote}"
          </blockquote>
          
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-primary-100 rounded-full flex items-center justify-center">
              <span class="text-primary-700 font-semibold text-lg">
                {testimonial.author.charAt(0)}
              </span>
            </div>
            <div>
              <p class="font-semibold text-gray-900">{testimonial.author}</p>
              <p class="text-sm text-gray-700">{testimonial.role}, {testimonial.company}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
